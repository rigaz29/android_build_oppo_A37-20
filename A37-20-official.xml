           remote="gh" revision="470e8d88f1490b24bfe76aa17bd2ea57bcaa4c27"
           upstream="lineage-20.0-legacy" />

  <!-- timekeep: dipakai device.mk:855 (PRODUCT_PACKAGES: timekeep) dan
       sepolicy/timekeep_app.te. Ada di org LineageOS branch lineage-20 tapi
       TIDAK didaftarkan manifest official lineage-20.0 (diverifikasi 6 Agu 2026
       lewat grep default.xml + snippets). SHA 11c1535c = HEAD lineage-20 yang
       juga HEAD lineage-21/22.0/22.1 (stabil). -->
  <project name="LineageOS/android_hardware_sony_timekeep" path="hardware/sony/timekeep"
           remote="gh" revision="11c1535c71b97f0ab833e215a8121ed107235010"
           upstream="lineage-20" />

</manifest>
