From b9d9d3fe700dd729a46f54d3b692fa104e60a748 Mon Sep 17 00:00:00 2001
From: rigaz29 <ryanbagas27@gmail.com>
Date: Sun, 13 Sep 2026 17:06:46 +0000
Subject: [PATCH] A37: matikan spoof versi kernel untuk LineageOS 20

CONFIG_ANDROID_TREBLE_SPOOF_KERNEL_VERSION dan tiga simbol pasangannya dimatikan.
Ia dibuat untuk LOS 22, tempat basis tidak lagi menyediakan fork art/ sehingga
gerbang memfd_create ART harus dibohongi dari kernel. LOS 20 menyelesaikan masalah
yang sama dari sisi lain, dan pemeriksaan konsumen satu per satu menunjukkan spoof
ini tidak membeli apa pun di sini:

  ART memfd    patches/official/art/0001 mencabut pemeriksaannya COMPILE-TIME lewat
               HAS_MEMFD_BACKPORT -- uname() tidak pernah dipanggil. Sama untuk
               external/perfetto.
  bpfloader    system/bpf membandingkan dengan 4.14 / 4.19 / 5.4
               (libbpf_android/Loader.cpp:650,767,777). 3.10 maupun 3.17 sama-sama
               di bawahnya; nol perubahan perilaku.
  init         ro.kernel.version dipakai init.rc:651-657 dengan pencocokan PERSIS
               4.9 / 4.14 / 4.19 / 5.4. Tidak satu pun cocok dengan 3.10 maupun 3.17.
  init modul   LoadKernelModules memilih /lib/modules/<versi>, tetapi kernel ini
               tanpa CONFIG_MODULES dan ROM tidak mengirim /lib/modules sama sekali.
  bootchart    kosmetik.

DAN ia meleset dari sasaran utamanya di build 64-bit: penyaringnya mencocokkan
current->comm == "zygote", sedangkan app_main.cpp:167 menamai zygote 64-bit
"zygote64" pada build __LP64__. Jadi zygote utama tidak pernah ikut ter-spoof --
mekanisme itu memang ditulis untuk ROM 32-bit.

Yang tersisa hanyalah ongkosnya: ro.kernel.version melaporkan 3.17 padahal kernelnya
3.10. Proyek ini sudah beberapa kali tertipu informasi yang menyesatkan; tidak perlu
menambah satu lagi demi nol keuntungan.

Ikut dibuang: blok komentar Image-dtb di ekor defconfig. Konfigurasinya sudah
di-revert hulu (e1a4070) dan alasannya khusus Android 16 yang mkbootimg-nya membuang
opsi --dt. LOS 20 memakai tabel DT terpisah lewat dtbtool di device tree.

TERVERIFIKASI
  make ARCH=arm64 lineageos_a37f_defconfig   rc=0
  CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"   (WAJIB: LOS 20 pakai VNDK)
  CONFIG_ANDROID_TREBLE_SPOOF_KERNEL_VERSION  tidak ada di .config
  PSI / WIREGUARD / RADIO_IRIS / F2FS_FS_ENCRYPTION / ADIANTUM / LOG_BUF_SHIFT=19  utuh
  CONFIG_ARM64_APPENDED_DTB  tidak ada  (jalur tabel DT terpisah tetap)

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014BuvxqsBMX7Bb8CRVeSTBj
---
 arch/arm64/configs/lineageos_a37f_defconfig | 44 ++++++++++++++++-----
 1 file changed, 34 insertions(+), 10 deletions(-)

diff --git a/arch/arm64/configs/lineageos_a37f_defconfig b/arch/arm64/configs/lineageos_a37f_defconfig
index 953560e61f9..7280c1dfb86 100644
--- a/arch/arm64/configs/lineageos_a37f_defconfig
+++ b/arch/arm64/configs/lineageos_a37f_defconfig
@@ -62,10 +62,35 @@ CONFIG_DEBUG_FS=y
 CONFIG_CC_STACKPROTECTOR=y
 CONFIG_CC_STACKPROTECTOR_REGULAR=y
 CONFIG_EMBEDDED=y
-CONFIG_ANDROID_TREBLE_SPOOF_KERNEL_VERSION=y
-CONFIG_ANDROID_TREBLE_BYPASS_KERNEL_VERSION_CHECKS=y
-CONFIG_ANDROID_TREBLE_SPOOF_KERNEL_VERSION_PREFIX="3.17"
-CONFIG_ANDROID_TREBLE_SPOOF_BPF_KERNEL_VERSION_PREFIX="3.17"
+# Spoof versi kernel DIMATIKAN untuk LineageOS 20 (Android 13).
+#
+# Ia dibuat untuk LOS 22, tempat basis tidak lagi menyediakan fork art/ sehingga
+# gerbang memfd_create ART harus dibohongi dari kernel. LOS 20 menyelesaikan
+# masalah yang sama dari sisi lain, dan pemeriksaan satu per satu menunjukkan
+# spoof ini tidak membeli apa pun di sini:
+#
+#   ART memfd     patches/official/art/0001 mencabut pemeriksaannya secara
+#                 COMPILE-TIME lewat HAS_MEMFD_BACKPORT -- uname() tidak pernah
+#                 dipanggil sama sekali. Sama untuk external/perfetto.
+#   bpfloader     system/bpf membandingkan dengan 4.14 / 4.19 / 5.4
+#                 (libbpf_android/Loader.cpp:650,767,777). 3.10 maupun 3.17
+#                 sama-sama di bawahnya; nol perubahan perilaku.
+#   init          ro.kernel.version dipakai init.rc:651-657 dengan pencocokan
+#                 PERSIS 4.9 / 4.14 / 4.19 / 5.4. Tidak satu pun cocok dengan
+#                 3.10 maupun 3.17.
+#   init modul    LoadKernelModules memakai versi untuk memilih /lib/modules/<v>,
+#                 tetapi kernel ini tanpa CONFIG_MODULES dan ROM tidak mengirim
+#                 /lib/modules sama sekali -- init langsung melewatinya.
+#
+# DAN ia meleset dari sasaran utamanya di build 64-bit: penyaringnya mencocokkan
+# current->comm == "zygote", sedangkan app_main.cpp:167 menamai zygote 64-bit
+# "zygote64" pada build __LP64__. Jadi zygote utama tidak pernah ikut ter-spoof.
+#
+# Yang tersisa hanyalah ONGKOSNYA: ro.kernel.version melaporkan 3.17 padahal
+# kernelnya 3.10, dan itu menyesatkan diagnosis berikutnya.
+#
+# NYALAKAN LAGI hanya kalau ada konsumen baru yang terbukti menuntutnya.
+# CONFIG_ANDROID_TREBLE_SPOOF_KERNEL_VERSION is not set
 # CONFIG_SLUB_DEBUG is not set
 # CONFIG_PROFILING is not set
 CONFIG_ARCH_MMAP_RND_COMPAT_BITS=16
@@ -755,9 +780,8 @@ CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
 CONFIG_CRYPTO_AES_ARM64_NEON_BLK=y
 CONFIG_QMI_ENCDEC=y
 
-# Bootloader msm8916 menuntut device tree DITEMPELKAN ke image kernel.
-# mkbootimg Android 16 sudah membuang opsi --dt ("ambiguous option: --dt could
-# match --dtb, --dtb_offset"), jadi penempelan dilakukan oleh kernel sendiri --
-# pendekatan yang sama dipakai a6010 di lineage-23.2 (BOARD_KERNEL_IMAGE_NAME
-# := zImage-dtb; A37 arm64 sehingga padanannya Image-dtb).
-# Lihat arch/arm64/boot/Makefile:32 dan arch/arm64/Kconfig:595.
+# CATATAN: blok komentar soal Image-dtb / penempelan DTB DIBUANG di sini.
+# Konfigurasinya sendiri sudah di-revert hulu (e1a4070), dan alasannya khusus
+# Android 16 yang mkbootimg-nya membuang opsi --dt. LineageOS 20 masih memakai
+# tabel DT terpisah lewat dtbtool di device tree, jadi komentar itu hanya
+# menyesatkan pembaca berikutnya.
