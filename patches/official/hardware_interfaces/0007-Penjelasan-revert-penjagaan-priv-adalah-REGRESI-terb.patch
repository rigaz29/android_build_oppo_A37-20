 camera/device/1.0/default/CameraDevice.cpp | 34 ++++------------------
 1 file changed, 6 insertions(+), 28 deletions(-)

diff --git a/camera/device/1.0/default/CameraDevice.cpp b/camera/device/1.0/default/CameraDevice.cpp
index bcacf830d..3226df66d 100644
--- a/camera/device/1.0/default/CameraDevice.cpp
+++ b/camera/device/1.0/default/CameraDevice.cpp
@@ -695,34 +695,12 @@ Return<Status> CameraDevice::open(const sp<ICameraDeviceCallback>& callback) {
      * tersedia" alih-alih menjatuhkan mediaserver. Berlaku untuk HAL mana pun
      * yang berperilaku sama, bukan cuma perangkat ini.
      */
-    /*
-     * A37, DIPERBAIKI 16 Sep 2026: `priv` ikut diperiksa, dan justru ITULAH
-     * yang menentukan.
-     *
-     * Versi pertama penjagaan ini hanya memeriksa mDevice dan mDevice->ops,
-     * dan TIDAK MENYALA -- crash-nya tetap terjadi dan pesan di bawah tidak
-     * pernah muncul di log. Tombstone-nya membuktikan biner baru memang jalan
-     * (offset CameraDevice::open bergeser dari +558 menjadi +640) sementara
-     * titik matinya tidak berubah:
-     *
-     *   #00 camera.msm8916.so  camera_set_callbacks+46   SIGSEGV @ 0x40
-     *
-     * Jadi mDevice dan mDevice->ops keduanya sah. Yang kosong adalah
-     * `mDevice->priv`: blob memulangkan device dengan ops terisi tetapi priv
-     * NULL, lalu camera_set_callbacks mengambil QCamera2HardwareInterface dari
-     * priv dan mendereference anggotanya di offset 0x40.
-     *
-     * `priv` adalah anggota publik struct camera_device (hardware/camera.h),
-     * dan pada HAL1 QCamera2 ia selalu terisi oleh open yang benar-benar
-     * berhasil. Memeriksanya di sini menangkap persis kasus "HAL bilang
-     * sukses padahal camera_open gagal".
-     */
-    if (mDevice == nullptr || mDevice->ops == nullptr || mDevice->priv == nullptr) {
-        ALOGE("%s: HAL reported success but returned an unusable device for camera %s "
-              "(device=%p ops=%p priv=%p)", __FUNCTION__, mCameraId.c_str(),
-              mDevice, mDevice ? mDevice->ops : nullptr,
-              mDevice ? mDevice->priv : nullptr);
-        mDevice = nullptr;
+    if (mDevice == nullptr || mDevice->ops == nullptr) {
+        ALOGE("%s: HAL reported success but returned an unusable device for camera %s",
+                __FUNCTION__, mCameraId.c_str());
+        if (mDevice != nullptr) {
+            mDevice = nullptr;
+        }
         return getHidlStatus(-ENODEV);
     }
 
