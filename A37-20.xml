           upstream="lineage-19.0-caf-msm8916" />

  <!-- ================================================================
       Pin anti-hanyut (upstream drift)
       ================================================================
       MASALAHNYA, ditemukan saat Fase 2 (5 Agustus 2026):

       Manifest LineageOS-UL menyematkan project ke BRANCH, bukan SHA
       (default revision="refs/heads/lineage-20.0"). Lini UL sendiri BEKU sejak
       2025-04-04, tapi repo LineageOS hulu TERUS BERGERAK di branch yang sama.
       Akibatnya `repo sync` menarik kode yang jauh lebih baru daripada fork UL
       yang mengelilinginya, tanpa peringatan apa pun.

       Terukur: 34 project yang dipin ke branch sudah bergerak melewati
       2025-05-01. Sebagian besar tidak ikut dibangun (wiki, website, scripts,
       crowdin, charter, hudson, mirror), tapi sisanya kode sungguhan.

       Yang SUDAH terbukti memutus build:

         external/dng_sdk
           Commit 624d019 "Crude DNG SDK 1.7.1 upgrade" (2025-12-12 — delapan
           bulan SETELAH UL beku) menambahkan sdk_version: "current" pada
           libdng_sdk berikut dependensi ke libjpeg. external/libjpeg-turbo
           (AOSP, dipin ke tag android-13.0.0_r75) tidak menyediakan varian
           sdk:sdk, jadi soong berhenti dengan:
               error: external/dng_sdk/Android.bp:165:1: dependency "libjpeg"
               of "libdng_sdk" missing variant:
                 os:android,image:,arch:arm_armv8-a_cortex-a53,sdk:sdk,link:shared
           Dipin ke 880b683 — commit tepat sebelum upgrade itu, bertanggal
           2025-04-17, sezaman dengan pembekuan UL.

       Deteksi ulang kapan saja: tools/check-drift.sh
       Tambahkan pin baru di sini HANYA kalau sebuah project terbukti memutus
       build — jangan memin 34-34-nya secara preventif, karena itu membekukan
       perbaikan keamanan aplikasi yang masih sah. -->
  <remove-project name="LineageOS/android_external_dng_sdk" />
  <project name="LineageOS/android_external_dng_sdk" path="external/dng_sdk"
           groups="pdk" remote="gh"
           revision="880b6833f9d5e131a8d9f92d6d0a836514fc711e"
           upstream="lineage-20.0" />

  <!-- Pin anti-hanyut: external/skia @ 0c334c1c2f (merge security r28).

       Ditemukan di Fase 8: skia yang hanyut (HEAD 926265bb27 "Backport DNG
       SDK 1.7.1 support in SkRawCodec", 2025-08-07 — SETELAH pembekuan UL)
       menuntut API dng_sdk 1.7.1, padahal dng_sdk dipin ke 880b683
       (pra-1.7.1, lihat pin di atas). Gejalanya:

         external/skia/src/codec/SkRawCodec.cpp:99:69:
           error: unknown type name 'dng_area_task_progress'

       Memperbarui dng_sdk ke 34e0a65 (versi 1.7.1 terbaru) TIDAK bisa:
       Android.bp-nya memakai sdk_version:"current" + dep libjpeg yang
       memutus soong (error varian sdk:sdk — alasan pin dng_sdk ada).

       Commit 0c334c1c2f = merge tag android-security-13.0.0_r28 — pasangan
       sezaman dng_sdk 880b683 (r28 juga). Diverifikasi: m libskia exit 0
       dengan pasangan ini. Pin sesuai kebijakan: yang terbukti memutus build. -->
  <remove-project name="LineageOS/android_external_skia" />
  <project name="LineageOS/android_external_skia" path="external/skia"
           groups="pdk" remote="gh"
           revision="0c334c1c2f0fdc89a5f90dddcbe195e160baf02d"
           upstream="lineage-20.0" />

  <!-- Pin anti-hanyut: packages/services/Mms @ 0cc94f1.

       Ditemukan di Fase 8: Mms hulu yang hanyut (HEAD d2f1fe6, 2025-08-14)
       mengimplementasikan API IMms 3-arg (addMultimediaMessageDraft dengan
       callingUser, dari fbb2828 2024-07), sedangkan fork UL frameworks/base
       (beku) memakai IMms 2-arg (tanpa callingUser — fork UL tidak pernah
